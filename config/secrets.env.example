# Copy to secrets.env and chmod 600 (gitignored).
# Only needed for aggregator APIs that require keys.

# Adzuna — free at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI — optional secondary aggregator
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# or OpenWeb Ninja direct:
# JSEARCH_API_KEY=
# JSEARCH_BASE_URL=https://jsearch.p.rapidapi.com

# Optional Telegram (watch.py --notify only; default is dry-run / print)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_IDS=
